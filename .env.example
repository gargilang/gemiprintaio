# Copy to .env.local and fill in. Docs: https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# Supabase (optional for local SQLite-only dev)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — never expose in client bundles
SUPABASE_SERVICE_ROLE_KEY=

# For npm run supabase:wipe / supabase:apply (Settings → Database → connection string, URI mode; append ?sslmode=require if needed)
# DATABASE_URL=
# DIRECT_URL=

# Optional
NEXT_PUBLIC_DB_MODE=hybrid
# Serverless (Vercel): skip mirroring mutations to ./database/gemiprint.db after Supabase writes
# GEMIPRINT_SKIP_SERVER_SQLITE_MIRROR=1
# PASSWORD_ENC_SECRET=

# Sync engine rollout flags
SYNC_ENGINE_V2=1
REALTIME_PULL_ENABLED=1
WEB_SERVER_MEDIATED_ONLY=1
SYNC_WAVE=1
