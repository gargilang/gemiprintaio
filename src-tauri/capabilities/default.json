{
  "identifier": "default",
  "description": "Default permissions for gemiprint app",
  "local": true,
  "remote": {
    "urls": [
      "http://127.0.0.1:3000/*",
      "http://127.0.0.1:3000/",
      "http://localhost:3000/*",
      "http://localhost:3000/",
      "http://127.0.0.1:3001/*",
      "http://127.0.0.1:3001/",
      "http://localhost:3001/*",
      "http://localhost:3001/"
    ]
  },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "fs:default",
    "dialog:default",
    "shell:default",
    "notification:default",
    "os:default",
    "updater:default",
    "process:default"
  ]
}
